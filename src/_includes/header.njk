{# src/_includes/header.njk #}
<div class="w3-bar">
  {% set current = page.url or '/' %}

  {% for item in site.nav %}
    {% set href = item.href | url %}
    {% set isActive = (current == href) or (current == '/' and href == '/') %}

    <a href="{{ href }}"
       class="w3-bar-item w3-button w3-mobile w3-round-medium w3-hover-deep-orange {% if isActive %}w3-deep-orange{% endif %}"
       {% if isActive %}aria-current="page"{% endif %}>
      {{ item.label }}
    </a>
  {% endfor %}
</div>
