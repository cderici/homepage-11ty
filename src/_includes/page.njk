<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle %}{% if title and title != "Home" %}{{ title }} · {% endif %}{{ site.title }}{% endset %}
  {%- set pageDescription = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="theme-color" content="#0d1422">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  {# link previews (LinkedIn, Slack, X, …); card source: design/og/card.html #}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-card.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.title }}, {{ site.role }} at {{ site.company }}">
  <meta name="twitter:card" content="summary_large_image">

  {# the two faces every page uses above the fold; the rest load on demand #}
  <link rel="preload" href="/assets/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script type="module" src="/assets/js/main.js"></script>
  {# old/new look switch (also used by the /classic/ snapshot) #}
  <style>{% include "look-switch.css" %}</style>
  <script>{% include "look-switch.js" %}</script>

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/favicon-180x180.png">
  <link rel="manifest" href="/site.webmanifest">
</head>
<body{% if glow and glow != "ember" %} data-glow="{{ glow }}"{% endif %}>
  <a class="skip-link" href="#content">Skip to content</a>

  <div class="page">
    <aside class="sidebar">
      {% include "profile-card.njk" %}
    </aside>

    <div class="column">
      {% include "nav.njk" %}
      <main id="content">
        {{ content | safe }}
      </main>
    </div>

    <footer class="site-footer">© {{ "now" | date("yyyy") }} {{ site.title }}</footer>
  </div>

  <button class="to-top" type="button" aria-label="Back to top">{% icon "arrow-up" %}</button>
  <a class="look-switch" href="/classic{{ page.url }}" title="See this page in the old design">{% icon "history" %}Old look</a>
  <dialog class="lightbox" aria-label="Photo viewer">
    <figure>
      <img alt="">
      <figcaption><span class="lb-caption"></span><span class="lb-count"></span></figcaption>
    </figure>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">{% icon "chevron-left" %}</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">{% icon "chevron-right" %}</button>
    <button class="lb-btn lb-close" type="button" aria-label="Close">{% icon "close" %}</button>
  </dialog>

</body>
</html>
