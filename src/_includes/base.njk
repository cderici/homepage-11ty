<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ page.title or "Home" }} · {{ site.title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# external CSS you use today #}
  <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="https://www.w3schools.com/lib/w3-colors-win8.css">
  <link rel="stylesheet" href="https://www.w3schools.com/lib/w3-colors-flat.css">

  {# your local CSS (passthrough) #}
  <link rel="stylesheet" href="/assets/css/caner.css">
  <link rel="stylesheet" href="/assets/css/lightbox.css">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
  <link rel="icon" type="image/png" sizes="180x180" href="/favicon-180x180.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
  <link rel="manifest" href="/site.webmanifest">

</head>
<body class="w3-flat-wet-asphalt">
  <main id="content">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}

  {# your JS, loaded last #}
  <script src="/assets/js/jquery-1.11.0.min.js"></script>
  <script src="/assets/js/lightbox.min.js"></script>
  <script src="/assets/js/caner.js"></script>
</body>
</html>
