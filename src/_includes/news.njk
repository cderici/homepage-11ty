{% card "News & Posts", "news" %}
  {% for m in news %}
    <h3 class="month">{{ m.month }}</h3>
    {% for it in m.items %}
      <article>
        <h4><a href="{{ it.url }}">{{ it.title }}</a></h4>
        <p>{{ it.blurb }}</p>
        {% if it.extra and it.extra.length %}
          <ul class="tags">
            {% for pair in it.extra %}
              <li><a href="{{ pair[1] }}">{{ pair[0] }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </article>
    {% endfor %}
  {% endfor %}
{% endcard %}
